<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Android 13+ asks the person before the app may show notifications
         (asked when they turn them on in Mais). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>

    <application>
        <service
            android:name="io.github.rafaelfaria1323.android_push.DealTrackerMessagingService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT"/>
            </intent-filter>
        </service>
    </application>
</manifest>
